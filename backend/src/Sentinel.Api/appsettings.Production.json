{
  "CommandSigning": { "ActiveSecret": "" },
  "AllowedHosts": "api.sentinel.example",
  "Keycloak": {
    "Authority": "https://identity.sentinel.example/realms/sentinel",
    "Audience": "sentinel-api",
    "AdminClientId": "sentinel-api",
    "AdminClientSecret": "replace-with-secret-manager-value"
  },
  "Cors": {
    "AllowedOrigins": [ "https://console.sentinel.example" ]
  },
  "ConnectionStrings": {
    "Sentinel": "Host=replace-with-pooler-host;Port=6543;Database=postgres;Username=replace-with-user;Password=replace-with-secret-manager-value;SSL Mode=Require;Trust Server Certificate=false"
  },
  "Bootstrap": {
    "OwnerPassword": "replace-with-secret-manager-value"
  },
  "CertificateAuthority": {
    "IssuingPfxBase64": "replace-with-secret-manager-value",
    "IssuingPfxPassword": "replace-with-secret-manager-value"
  },
  "ForwardedHeaders": {
    "KnownProxies": [ "10.0.0.10" ]
  }
}
