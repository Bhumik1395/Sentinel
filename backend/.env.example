# Copy to backend/.env for local Docker Compose development. Never commit backend/.env.
NEO4J_PASSWORD=replace-with-a-long-local-password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-local-password
LOCAL_DB_PASSWORD=replace-with-a-long-local-password

# Required only by the production Docker Compose profile.
POSTGRES_PASSWORD=replace-with-a-long-production-password
REDIS_PASSWORD=replace-with-a-long-production-password
CommandSigning__ActiveSecret=replace-with-a-32-byte-random-secret
